# testnet only. pnpm keys mints the three keys into .env and prints the near-cli commands that register them
NEAR_RPC=https://test.rpc.fastnear.com
NEAR_ARCHIVAL_RPC=https://archival-rpc.testnet.fastnear.com
GUARD_ID=guard.countersign-owner.testnet
OWNER_ID=countersign-owner.testnet
AGENT_ID=agent.countersign-owner.testnet
OWNER_KEY=
AGENT_LEASH_KEY=
AGENT_FULL_KEY=

# any openai-compatible endpoint. NEAR AI Cloud: https://cloud-api.near.ai/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
